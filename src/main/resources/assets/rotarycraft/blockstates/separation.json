{
  "multipart": [
    {
      "apply": {
        "model": "rotarycraft:block/pipe/separation/core"
      }
    },
    {
      "when": {
        "conn_down": "true"
      },
      "apply": {
        "model": "rotarycraft:block/pipe/separation/arm_down"
      }
    },
    {
      "when": {
        "conn_up": "true"
      },
      "apply": {
        "model": "rotarycraft:block/pipe/separation/arm_up"
      }
    },
    {
      "when": {
        "conn_north": "true"
      },
      "apply": {
        "model": "rotarycraft:block/pipe/separation/arm_north"
      }
    },
    {
      "when": {
        "conn_south": "true"
      },
      "apply": {
        "model": "rotarycraft:block/pipe/separation/arm_south"
      }
    },
    {
      "when": {
        "conn_west": "true"
      },
      "apply": {
        "model": "rotarycraft:block/pipe/separation/arm_west"
      }
    },
    {
      "when": {
        "conn_east": "true"
      },
      "apply": {
        "model": "rotarycraft:block/pipe/separation/arm_east"
      }
    },
    {
      "when": {
        "conn_west": "false",
        "conn_north": "false"
      },
      "apply": {
        "model": "rotarycraft:block/pipe/separation/vedge_wn"
      }
    },
    {
      "when": {
        "conn_west": "false",
        "conn_south": "false"
      },
      "apply": {
        "model": "rotarycraft:block/pipe/separation/vedge_ws"
      }
    },
    {
      "when": {
        "conn_east": "false",
        "conn_north": "false"
      },
      "apply": {
        "model": "rotarycraft:block/pipe/separation/vedge_en"
      }
    },
    {
      "when": {
        "conn_east": "false",
        "conn_south": "false"
      },
      "apply": {
        "model": "rotarycraft:block/pipe/separation/vedge_es"
      }
    }
  ]
}
