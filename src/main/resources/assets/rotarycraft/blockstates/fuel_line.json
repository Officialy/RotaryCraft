{
  "multipart": [
    {
      "apply": {
        "model": "rotarycraft:block/pipe/fuel_line/core"
      }
    },
    {
      "when": {
        "conn_down": "true"
      },
      "apply": {
        "model": "rotarycraft:block/pipe/fuel_line/arm_down"
      }
    },
    {
      "when": {
        "conn_up": "true"
      },
      "apply": {
        "model": "rotarycraft:block/pipe/fuel_line/arm_up"
      }
    },
    {
      "when": {
        "conn_north": "true"
      },
      "apply": {
        "model": "rotarycraft:block/pipe/fuel_line/arm_north"
      }
    },
    {
      "when": {
        "conn_south": "true"
      },
      "apply": {
        "model": "rotarycraft:block/pipe/fuel_line/arm_south"
      }
    },
    {
      "when": {
        "conn_west": "true"
      },
      "apply": {
        "model": "rotarycraft:block/pipe/fuel_line/arm_west"
      }
    },
    {
      "when": {
        "conn_east": "true"
      },
      "apply": {
        "model": "rotarycraft:block/pipe/fuel_line/arm_east"
      }
    }
  ]
}
